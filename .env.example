# Run scripts/setup_dev_db.py to generate local-only credentials in ignored .env.
POSTGRES_IMAGE=postgres:16
POSTGRES_PORT=15432
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://job_agent:CHANGE_ME@127.0.0.1:15432/job_application_agent_dev
LOCAL_USER_ID=00000000-0000-0000-0000-000000000001

# P4模型提取；将真实凭据放进被忽略的.env或进程环境。
REDIS_URL=redis://localhost:6379/1
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=

# P10 local is loopback-only; private requires login and HTTPS at the reverse proxy.
APP_MODE=local
APP_ACCESS_TOKEN=
COOKIE_SECURE=false
MAIL_CREDENTIAL_KEY=
MAIL_POLL_ENABLED=true
MAIL_POLL_SECONDS=43200
MODEL_REQUESTS_PER_HOUR=30

# P11 process budgets: 1 API x5 + 1 worker x8 + 1 scheduler x3 = 16, plus migration/admin reserve.
# Generate a unique APP_SESSION_SECRET using scripts/configure_delivery.py; never commit .env.
APP_SESSION_SECRET=
API_DB_POOL_MAX=5
WORKER_DB_POOL_MAX=8
SCHEDULER_DB_POOL_MAX=3
DB_ACQUIRE_TIMEOUT=5
DB_QUERY_TIMEOUT=30
WORKER_CONCURRENCY=2
MODEL_CONCURRENCY_LIMIT=2
JOB_QUEUE_LIMIT=200
JOB_OWNER_QUEUE_LIMIT=100
JOB_LEASE_SECONDS=30
JOB_MAX_ATTEMPTS=3
JOB_EXECUTION_TIMEOUT=90
MAIL_SCHEDULER_TICK_SECONDS=5
MAIL_SYNC_LEASE_SECONDS=120
ENABLE_SYNC_DIAGNOSTICS=false

# P11.6: process heartbeat and queue age observation (seconds).
OBSERVATION_HEARTBEAT_SECONDS=5
OBSERVATION_STALE_SECONDS=20
OBSERVATION_QUEUE_WAIT_SECONDS=30
